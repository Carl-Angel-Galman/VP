#include "GasSensor.h"

int32_t gasSensorInitialize(GasSensor* pSensor, uint32_t convFactor)
{

	if(pSensor == 0)
	{
		return SENSOR_INVALID_PTR;
	}

	pSensor->sensorVoltage = 0;
	pSensor->conversionFactor = convFactor;

	return SENSOR_OK;
}

int32_t gasSensorSetSensorVoltage(GasSensor* pSensor, uint32_t sensorVoltage)
{

	if(pSensor == 0)
	{
		return SENSOR_INVALID_PTR;

	}

	pSensor->sensorVoltage = sensorVoltage * pSensor->conversionFactor;

	return SENSOR_OK;
}

int32_t gasSensorGetSensorVoltage(GasSensor* pSensor, uint32_t* returnValue)
{
	if(pSensor == 0)
		{
			return SENSOR_INVALID_PTR;

		}

		&returnValue = pSensor->sensorVoltage;

		return SENSOR_OK;
}

